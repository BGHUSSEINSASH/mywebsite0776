# generated by tools/make-htaccess.js — do not edit by hand.
# the policy lives in tools/security-config.js; this is its Apache
# rendering, and check-security.js compares the two on every build.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # assets carry a ?v=rNN token and never change under it, so they are the
  # one thing on the site a browser may keep for a year
  RewriteRule ^assets/ - [E=BGSASH_IMMUTABLE:1]

  # /index.html and /work/bookly.html are the same page as / and
  # /work/bookly, and two urls for one page is two entries in a search
  # index. the clean one wins.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # …and the clean url has to find its file again. a real file or a real
  # directory is left alone, so /api/profile.json, /manifest.webmanifest
  # and /.well-known/security.txt all pass straight through.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# a miss answers with the real 404 page and a real 404 status — a soft
# 404 is a page that tells a search engine it exists
ErrorDocument 404 /404.html

# chrome refuses a manifest it does not recognise, and not every Apache
# build ships these two types
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  # everything, everywhere
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' https://api.github.com https://*.supabase.co https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' mailto: https://wa.me; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), display-capture=(), serial=(), hid=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # later directives win over earlier ones for the same header, so the
  # order below is the policy: re-validate everything, keep the assets
  # that carry a ?v=rNN token for a year, and never keep a page.
  Header always set Cache-Control "no-cache"
  Header always set Cache-Control "public, max-age=31536000, immutable" env=BGSASH_IMMUTABLE
  <FilesMatch "\.(html|webmanifest)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # the desk leaks nothing, not even a referrer. matched on the file, so
  # it covers /admin as well as /admin.html after the rewrite above.
  <FilesMatch "^admin\.html$">
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set Referrer-Policy "no-referrer"
  </FilesMatch>
</IfModule>

